# ===== 必填 =====
# 客戶端連線用的位址：固定 IP 直接填 IP，浮動 IP 填 DDNS 網域（例如 myhome.duckdns.org）
SERVER_DOMAIN=myhome.duckdns.org

# ===== VLESS + Reality（TCP）=====
REALITY_PORT=443
# 借用的偽裝目標：必須支援 TLS 1.3 + HTTP/2，選離主機近、延遲低的網站
# 用 scripts/check-target.sh <網域> 檢查
REALITY_TARGET=www.microsoft.com

# ===== Hysteria 2（UDP）=====
# UDP 443 最像正常的 HTTP/3，而且不會和 Reality 的 TCP 443 衝突
HY2_PORT=443
# 填你家「上傳」頻寬（Mbps）就會啟用 Brutal；留空則改用 BBR（較溫和，推薦先用這個）
HY2_UP_MBPS=
HY2_DOWN_MBPS=
# 被探測時反向代理到這個網站
HY2_MASQUERADE=https://www.bing.com
# hy2 自簽憑證名稱與 SNI，留空會用偽裝網站的主機名（www.bing.com）
HY2_SNI=

# 監聽位址；主機關閉 IPv6 時改成 0.0.0.0
LISTEN_ADDR=::

# Linux 主機用 docker；在 Mac 上用 Apple container 測試時改成 container
CONTAINER_CLI=docker

# ===== DDNS（二選一，啟動時用 --profile 指定）=====
TZ=Asia/Taipei
# DuckDNS：SUBDOMAINS 只填前綴，例如 myhome
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=
# Cloudflare：Token 權限只需要 Zone.DNS:Edit
CLOUDFLARE_API_TOKEN=
